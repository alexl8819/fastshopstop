---
import { name } from '../../package.json';
---

<footer id="footer-contact" class="bg-(--ink) text-(--paper) border-t-6 border-t-(--stamp-red) pt-12.5 pb-7.5 px-0">
  <div class="max-w-7xl py-0 px-7 my-0 mx-auto">
    <div class="grid grid-cols-[1fr] md:grid-cols-[1.4fr_1fr_1fr] gap-10 mb-9">
      <div>
        <h5 class="font-ibm-plex-mono text-[12px] tracking-widest text-(--gold) mb-3.5 uppercase">{ name }</h5>
        <p class="text-[13px] text-[#C9CFDA] heading-[1.6] m-0">A small resale outfit moving collectables, electronics and sportswear out of the unit and into your hands. New drops come every once and a while.</p>
      </div>
      <div>
        <h5 class="font-ibm-plex-mono text-[12px] tracking-widest text-(--gold) mb-3.5 uppercase">Shop</h5>
        <ul class="list-none p-0 m-0">
          <li class="font-[13px] text-[#B9BDC6] heading-[1.7]"><a href="/#bins" class="hover:text-(--gold)">Collectables</a></li>
          <li class="font-[13px] text-[#B9BDC6] heading-[1.7]"><a href="/#bins" class="hover:text-(--gold)">Electronics</a></li>
          <li class="font-[13px] text-[#B9BDC6] heading-[1.7]"><a href="/#bins" class="hover:text-(--gold)">Sportswear</a></li>
          <li class="font-[13px] text-[#B9BDC6] heading-[1.7]"><a href="/#inventory" class="hover:text-(--gold)">Full inventory</a></li>
        </ul>
      </div>
      <div>
        <h5 class="font-ibm-plex-mono text-[12px] tracking-widest text-(--gold) mb-3.5 uppercase">Info</h5>
        <ul class="list-none p-0 m-0">
          <li class="font-[13px] text-[#B9BDC6] heading-[1.7]"><a href="/faq" class="hover:text-(--gold)">FAQ</a></li>
          <li class="font-[13px] text-[#B9BDC6] heading-[1.7]"><a href="/shipping" class="hover:text-(--gold)">Shipping &amp; returns</a></li>
          <li class="font-[13px] text-[#B9BDC6] heading-[1.7]"><a href="/contact" class="hover:text-(--gold)">Contact</a></li>
          <li class="font-[13px] text-[#B9BDC6] heading-[1.7]"><a href={`https://www.ebay.com/usr/${name}`} target="_blank" rel="noopener" class="hover:text-(--gold)">Our eBay store ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="border-b border-b-[#333944] pt-5 flex justify-between flex-wrap gap-2.5 font-ibm-plex-mono text-[11px] text-[#7d818a]">
      <p>© 2021 - { new Date().getFullYear() } <span class="uppercase">{ name }</span>. Not affiliated with eBay Inc. All listings link out to eBay.</p>
    </div>
  </div>
</footer>