---
const { isSolid, isSubmit, isLink, text, url = null, handler = () => {} } = Astro.props;

const classes = `inline-flex items-center gap-2 font-ibm-plex-mono text-[13px] font-semibold tracking-[0.02em] py-3.25 px-5.5 border-2 transition-all duration-[.12s] ease-in
    ${isSolid ? 'bg-(--gold) border-(--gold) text-(--navy) hover:bg-(--paper) hover:border-(--paper)' : 'bg-transparent border-(--paper) text-(--paper) hover:transform hover:translate-[-2px_-2px]'}
`;
---
{
    isLink ? 
        <a class={classes} href={url}>
            { !text && !text.length ? <slot name="content"></slot> : text }
        </a> : 
        <button type="button" class={classes} onclick={handler}>
            { !text && !text.length ? <slot name="content"></slot> : text }
        </button>
}